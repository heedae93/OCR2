<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level [%thread] %logger{30} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 외부 라이브러리 로그 최소화 -->
    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>

    <!-- 우리 코드만 INFO 레벨 -->
    <logger name="tika" level="INFO"/>
</configuration>
